# The name other devices open, without https:// in front. It must point at this machine, with
# ports 80 and 443 reaching it. To try it on your own computer first: aubergine.localhost
AUBERGINE_HOST=aubergine.example.net
# Which published image `docker compose pull` fetches: a version such as 0.2.0, or latest (the
# default). A build from the checkout is given the same name. See docker/compose.yaml.
# AUBERGINE_TAG=latest
